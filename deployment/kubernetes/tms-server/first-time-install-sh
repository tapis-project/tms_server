TAPIS_DB_HOST="${TMS_DB_HOST:-tms-postgres-18}"
TAPIS_DB_PORT="${TMS_DB_PORT}:-5432"
DB_USER=postgres
DB_NAME=tmsdb
export TMS_DB_SCHEMA=tms

PSQL_CMD="psql --host=${TAPIS_DB_HOST} --port=${TAPIS_DB_PORT}"

if [ -z "${TMS_DB_USER_PASSWORD}" ]; then
  echo "Please set env var TMS_DB_USER_PASSWORD before running this script"
  exit 1
fi

